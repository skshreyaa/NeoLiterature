    "model": "curriculum.voicepracticeitem",
    "pk": 247,
    "fields": {
      "level": "advanced",
      "language": "kn",
      "text": "ಪ್ರಾಮಾಣಿಕತೆಯು ಯಾವುದೇ ಸಂಬಂಧದಲ್ಲಿ ನಂಬಿಕೆಯ ಅಡಿಪಾಯವಾಗಿದೆ",
      "image_url": "",
