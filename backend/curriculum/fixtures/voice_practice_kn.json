    "model": "curriculum.voicepracticeitem",
    "pk": 249,
    "fields": {
      "level": "advanced",
      "language": "kn",
      "text": "ವಿಜ್ಞಾನಿಗಳು ಬ್ರಹ್ಮಾಂಡದ ಬಗ್ಗೆ ಹೊಸ ಮಾಹಿತಿಯನ್ನು ಕಂಡುಹಿಡಿಯುತ್ತಲೇ ಇದ್ದಾರೆ",
      "image_url": "",
