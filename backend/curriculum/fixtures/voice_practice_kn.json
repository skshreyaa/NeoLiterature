    "pk": 244,
    "fields": {
      "level": "advanced",
      "language": "kn",
      "text": "ಪ್ರತಿಕ್ರಿಯಿಸುವ ಮೊದಲು ಎಚ್ಚರಿಕೆಯಿಂದ ಕೇಳುವುದು ಮುಖ್ಯ",
      "image_url": "",
