    "model": "curriculum.voicepracticeitem",
    "pk": 246,
    "fields": {
      "level": "advanced",
      "language": "kn",
      "text": "ಪ್ರಯಾಣವು ವಿವಿಧ ಸಂಸ್ಕೃತಿಗಳ ತಿಳುವಳಿಕೆಯನ್ನು ವಿಸ್ತರಿಸುತ್ತದೆ",
      "image_url": "",
      "order": 11
    }
  },
