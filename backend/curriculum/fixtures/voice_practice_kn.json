    "model": "curriculum.voicepracticeitem",
    "pk": 248,
    "fields": {
      "level": "advanced",
      "language": "kn",
      "text": "ಪುಟಗಳನ್ನು ತಿರುಗಿಸುವ ಶಬ್ದವನ್ನು ಹೊರತುಪಡಿಸಿ ಗ್ರಂಥಾಲಯ ಶಾಂತವಾಗಿತ್ತು",
      "image_url": "",
      "order": 13
    }
  },
