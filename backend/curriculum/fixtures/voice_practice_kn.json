    "model": "curriculum.voicepracticeitem",
    "pk": 238,
    "fields": {
      "level": "advanced",
      "language": "kn",
      "text": "ಈ ವರ್ಷ ನಾನು ಹೊಸ ಕೌಶಲ್ಯವನ್ನು ಕಲಿಯಲು ಬಯಸುತ್ತೇನೆ",
