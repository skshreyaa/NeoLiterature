    "model": "curriculum.voicepracticeitem",
    "pk": 250,
    "fields": {
      "level": "advanced",
      "language": "kn",
      "text": "ಉತ್ತಮ ಸಂವಹನ ಕೌಶಲ್ಯಗಳು ಪ್ರತಿಯೊಂದು ವೃತ್ತಿಯಲ್ಲಿ ಮೌಲ್ಯಯುತವಾಗಿವೆ",
      "image_url": "",
      "order": 15
    }
  },
