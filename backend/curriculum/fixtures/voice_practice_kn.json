    "model": "curriculum.voicepracticeitem",
    "pk": 245,
    "fields": {
      "level": "advanced",
      "language": "kn",
      "text": "ಸಮತೋಲಿತ ಆಹಾರವು ಉತ್ತಮ ಆರೋಗ್ಯಕ್ಕೆ ಕೊಡುಗೆ ನೀಡುತ್ತದೆ",
