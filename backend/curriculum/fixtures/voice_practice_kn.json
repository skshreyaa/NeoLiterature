    "pk": 251,
    "fields": {
      "level": "advanced",
      "language": "kn",
      "text": "ಕಷ್ಟದ ಸಮಯದಲ್ಲಿ ಸಮುದಾಯ ಬೆಂಬಲವು ಗಮನಾರ್ಹ ವ್ಯತ್ಯಾಸವನ್ನು ಮಾಡಬಹುದು",
      "image_url": "",
