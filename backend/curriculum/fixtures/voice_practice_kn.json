  },
  {
    "model": "curriculum.voicepracticeitem",
    "pk": 236,
    "fields": {
      "level": "advanced",
      "language": "kn",
      "text": "ಸೂರ್ಯ ಪ್ರತಿದಿನ ಬೆಳಿಗ್ಗೆ ಪೂರ್ವದಲ್ಲಿ ಉದಯಿಸುತ್ತಾನೆ",
