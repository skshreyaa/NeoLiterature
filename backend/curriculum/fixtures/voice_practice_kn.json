    "model": "curriculum.voicepracticeitem",
    "pk": 243,
    "fields": {
      "level": "advanced",
      "language": "kn",
      "text": "ತಂತ್ರಜ್ಞಾನವು ನಾವು ಸಂವಹನ ಮಾಡುವ ವಿಧಾನವನ್ನು ಬದಲಾಯಿಸಿದೆ",
