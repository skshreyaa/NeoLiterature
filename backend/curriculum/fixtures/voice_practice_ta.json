  },
  {
    "model": "curriculum.voicepracticeitem",
    "pk": 344,
    "fields": {
      "level": "advanced",
      "language": "ta",
      "text": "பதிலளிப்பதற்கு முன் கவனமாகக் கேட்பது முக்கியம்",
      "image_url": "",
      "order": 9
    }
  },
  {
    "model": "curriculum.voicepracticeitem",
    "pk": 345,
    "fields": {
      "level": "advanced",
      "language": "ta",
      "text": "சமச்சீரான உணவு நல்ல ஆரோக்கியத்திற்கு பங்களிக்கிறது",
      "image_url": "",
      "order": 10
    }
  },
  {
    "model": "curriculum.voicepracticeitem",
    "pk": 346,
    "fields": {
      "level": "advanced",
      "language": "ta",
      "text": "பயணம் பல்வேறு கலாச்சாரங்களைப் புரிந்துகொள்வதை விரிவுபடுத்துகிறது",
      "image_url": "",
      "order": 11
    }
  },
  {
    "model": "curriculum.voicepracticeitem",
    "pk": 347,
    "fields": {
      "level": "advanced",
      "language": "ta",
      "text": "நேர்மை எந்தவொரு உறவிலும் நம்பிக்கையின் அடித்தளமாகும்",
      "image_url": "",
      "order": 12
    }
  },
  {
    "model": "curriculum.voicepracticeitem",
    "pk": 348,
    "fields": {
      "level": "advanced",
      "language": "ta",
      "text": "பக்கங்களைப் புரட்டும் சத்தத்தைத் தவிர நூலகம் அமைதியாக இருந்தது",
      "image_url": "",
      "order": 13
    }
  },
  {
    "model": "curriculum.voicepracticeitem",
    "pk": 349,
    "fields": {
      "level": "advanced",
      "language": "ta",
      "text": "விஞ்ஞானிகள் பிரபஞ்சத்தைப் பற்றிய புதிய தகவல்களைக் கண்டறிந்து கொண்டே இருக்கிறார்கள்",
      "image_url": "",
      "order": 14
    }
  },
  {
    "model": "curriculum.voicepracticeitem",
    "pk": 350,
    "fields": {
      "level": "advanced",
      "language": "ta",
      "text": "நல்ல தொடர்பாடல் திறன்கள் ஒவ்வொரு தொழிலிலும் மதிப்புமிக்கவை",
      "image_url": "",
      "order": 15
    }
  },
  {
    "model": "curriculum.voicepracticeitem",
    "pk": 351,
    "fields": {
      "level": "advanced",
      "language": "ta",
      "text": "கடினமான காலங்களில் சமூக ஆதரவு குறிப்பிடத்தக்க மாற்றத்தை ஏற்படுத்தும்",
      "image_url": "",
      "order": 16
    }
  },
  {
    "model": "curriculum.voicepracticeitem",
    "pk": 352,
    "fields": {
      "level": "advanced",
      "language": "ta",
      "text": "எந்தவொரு திறனிலும் தேர்ச்சி பெற பயிற்சியும் பொறுமையும் அவசியம்",
      "image_url": "",
      "order": 17
    }
  },
  {
    "model": "curriculum.voicepracticeitem",
    "pk": 353,
    "fields": {
      "level": "advanced",
      "language": "ta",
      "text": "பொருளாதாரம் உற்பத்தி மற்றும் நுகர்வு இரண்டையும் சார்ந்துள்ளது",
      "image_url": "",
      "order": 18
    }
  }
