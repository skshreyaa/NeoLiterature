  },
  {
    "model": "curriculum.voicepracticeitem",
    "pk": 336,
    "fields": {
      "level": "advanced",
      "language": "ta",
      "text": "சூரியன் ஒவ்வொரு நாளும் காலையில் கிழக்கில் உதிக்கிறது",
      "image_url": "",
      "order": 1
