  },
  {
    "model": "curriculum.voicepracticeitem",
    "pk": 343,
    "fields": {
      "level": "advanced",
      "language": "ta",
      "text": "தொழில்நுட்பம் நாம் தொடர்பு கொள்ளும் விதத்தை மாற்றியுள்ளது",
      "image_url": "",
      "order": 8
