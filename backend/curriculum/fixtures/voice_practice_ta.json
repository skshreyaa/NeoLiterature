  },
  {
    "model": "curriculum.voicepracticeitem",
    "pk": 337,
    "fields": {
      "level": "advanced",
      "language": "ta",
      "text": "படிப்பது உலகைப் புரிந்துகொள்ள உதவுகிறது",
