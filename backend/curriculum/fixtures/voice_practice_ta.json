    }
  },
  {
    "model": "curriculum.voicepracticeitem",
    "pk": 341,
    "fields": {
      "level": "advanced",
      "language": "ta",
      "text": "எதிர்கால சந்ததியினருக்காக நாம் சுற்றுச்சூழலைப் பாதுகாக்க வேண்டும்",
      "image_url": "",
      "order": 6
    }
  },
  {
    "model": "curriculum.voicepracticeitem",
    "pk": 342,
    "fields": {
      "level": "advanced",
      "language": "ta",
      "text": "வெற்றி காலப்போக்கில் தொடர்ச்சியான முயற்சியிலிருந்து வருகிறது",
      "image_url": "",
