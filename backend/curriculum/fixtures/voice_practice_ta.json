  },
  {
    "model": "curriculum.voicepracticeitem",
    "pk": 338,
    "fields": {
      "level": "advanced",
      "language": "ta",
      "text": "இந்த ஆண்டு நான் ஒரு புதிய திறனைக் கற்க விரும்புகிறேன்",
