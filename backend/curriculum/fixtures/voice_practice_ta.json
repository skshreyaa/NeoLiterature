  },
  {
    "model": "curriculum.voicepracticeitem",
    "pk": 340,
    "fields": {
      "level": "advanced",
      "language": "ta",
      "text": "கல்வி ஒரு சிறந்த எதிர்காலத்திற்கான திறவுகோல்",
