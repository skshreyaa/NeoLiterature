  },
  {
    "model": "curriculum.voicepracticeitem",
    "pk": 339,
    "fields": {
      "level": "advanced",
      "language": "ta",
      "text": "தண்ணீர் வாழ்க்கைக்கு மிகவும் முக்கியமானது",
